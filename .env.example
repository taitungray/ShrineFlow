# 複製成 .env 後填入。請勿把金鑰提交到 Git。
GEMINI_API_KEY=
# Gemini 免費層有用量限制；可依帳號可用模型調整。
GEMINI_MODEL=gemini-3.6-flash
# 可填入逗號分隔的備援模型；請使用 Google AI Studio 帳號目前可用的模型名稱。
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
# 503／429 等暫時性錯誤的重試設定。
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_MS=1000

# Facebook 粉專發布。Token 必須具備 pages_manage_posts 權限，請勿提交到 Git。
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Meta Graph API 版本可依 Meta 開發者後台目前支援版本調整。
META_GRAPH_VERSION=v25.0
# Webhook 驗證只使用伺服器端秘密；不會回傳前端或打包到備份。
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# 單一操作員正式部署必填；session 只保存在記憶體，不使用資料庫。
SHRINEFLOW_OPERATOR_PASSWORD=
SHRINEFLOW_SESSION_SECRET=
# Instagram／Threads 有圖片或影片時，需填可由平台讀取的 HTTPS 網址。
PUBLIC_MEDIA_BASE_URL=
# 設定後，下一次寫入會以 AES-256-GCM 加密 Token；請用密碼管理器保存，遺失無法解密。
SHRINEFLOW_MASTER_KEY=
# 每隔幾毫秒檢查一次到期排程；預設 30 秒。
FACEBOOK_SCHEDULER_INTERVAL_MS=30000
FACEBOOK_SCHEDULER_MAX_ATTEMPTS=3
FACEBOOK_SCHEDULER_RETRY_BASE_MS=60000
# local??????? setInterval?cloud??? Cloud Scheduler tick?production ??? cloud?
SHRINEFLOW_SCHEDULER_MODE=local
# ??? shared secret ?????????????Cloud Run IAM ??????
SHRINEFLOW_SCHEDULER_TOKEN=
# Cloud Run ?? OIDC?IAM ??????? true??????????????????
SHRINEFLOW_SCHEDULER_ALLOW_PLATFORM_AUTH=false
# local-json?????? migration ???Firestore adapter ???????
SHRINEFLOW_STORAGE_BACKEND=local-json
# Firestore Native mode (production)
FIRESTORE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# local-filesystem?????? migration ???R2 adapter ???????
SHRINEFLOW_MEDIA_BACKEND=local-filesystem
# Cloudflare R2 (production media backend)
R2_ACCOUNT_ID=
R2_BUCKET=shrineflow-media
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_UPLOAD_TTL_SECONDS=900
SHRINEFLOW_SCHEDULER_LEASE_MS=300000

PORT=3000
